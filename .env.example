# inkai-backend API (wajib di Vercel Production — jangan andalkan fallback hardcoded saja)
# Region fungsi portal: sin1 (lihat vercel.json) agar dekat Supabase ap-southeast-1.
# Backend (inkai-ecosystem) juga harus di-region sin1 — login lewat POST /v1/auth/login.
INKAI_API_URL="https://inkai-ecosystem.vercel.app"
NEXT_PUBLIC_INKAI_API_URL="https://inkai-ecosystem.vercel.app"

# Auth — NextAuth session membungkus JWT dari inkai-backend
AUTH_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Opsional: matikan mode ambil alih (impersonasi). Default aktif jika tidak diset.
# IMPERSONATION_ENABLED=false

# Opsional: masih dipakai halaman UKT/admin SSR sampai modul UKT dipindah ke backend
# Produksi portal (Vercel inkai-sby): Supabase project ref ztrryuhhdoqdglajukuw
# (aws-0-ap-southeast-1.pooler.supabase.com). Jangan apply SQL ke inkai-db /
# mzmdhkwleufeiyaspmns — itu salinan lama, bukan DB yang dibaca app produksi.
# Sebelum deploy field Prisma baru: npm run db:check-drift (harus exit 0 vs DB app).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional: email reset password (Resend) — jika backend belum kirim email
# RESEND_API_KEY=
# EMAIL_FROM="INKAI Surabaya <noreply@yourdomain.com>"

# Optional: URL proyek Supabase (storage gambar memakai bucket portal-public)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# Service/secret key (server) — dipakai upload jika BLOB tidak diset
SUPABASE_SECRET_KEY=

# Optional: Vercel Blob — prioritas jika diset; fallback ke Supabase Storage
# Buat token di Vercel Dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN=

# Optional: Upstash Redis — rate limit bersama antar instance serverless
# Tanpa ini, rate limit jatuh ke memori per instance (kurang efektif di Vercel)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Tanya INKAI (chat AI) — MixRoute OpenAI-compatible (pola app/asisten)
# Salin MIXROUTE_API_KEY dari asisten / console.mixroute.ai
# MIXROUTE_API_KEY=
# AI_BASE_URL=https://api.mixroute.ai/v1
# Opsional override model (default: gpt-4o-mini)
# TANYA_INKAI_MODEL=gpt-4o-mini
# Tanpa MIXROUTE_API_KEY, chat tetap menjawab dari knowledge lokal (mode degraded)

# Catatan pool DB: prefer Transaction pooler :6543 + ?pgbouncer=true&connection_limit=1
# Session mode (~15 client) sering memicu EMAXCONNSESSION di production

# --- Lokal Docker (dev full-stack tanpa Supabase) ---
# Salin blok ini ke .env.local saat dev lokal. Port host 5433 (bukan 5432).
# DATABASE_URL="postgresql://inkai:inkai@127.0.0.1:5433/inkai_local?schema=public"
# DIRECT_URL="postgresql://inkai:inkai@127.0.0.1:5433/inkai_local?schema=public"
# INKAI_API_URL="http://localhost:5001"
# NEXT_PUBLIC_INKAI_API_URL="http://localhost:5001"
# AUTH_SECRET="dev-local-secret-minimum-32-characters"
# NEXTAUTH_URL="http://localhost:3000"
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
#
# Urutan: Docker Desktop → npm run db:local:up → npm run db:local:bootstrap
# (atau: db push tanpa seed → dump dari prod)
# Backend sibling inkai-backend (:5001) wajib dengan DATABASE_URL yang sama.
# Verifikasi GET /health/db (backend) dan /api/auth/health (portal) sebelum klaim lokal jalan.
# Login seed: admin@local.inkai / cabang@local.inkai / ranting@local.inkai / anggota@local.inkai — password: inkai-local
#
# --- Dump one-way produksi → lokal (debug; bukan sync dua arah) ---
# Wajib URL produksi terpisah (session/direct Supabase inkai-db). Jangan commit secret.
# PROD_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Urutan: db:local:up → pastikan DATABASE_URL lokal :5433 → npm run db:local:dump-from-prod
# Setelah dump: password semua user = inkai-local; email = local+<id>@local.inkai
# Jangan jalankan db:local:seed setelah dump (menimpa data). Sync lokal→cloud TIDAK ada.
