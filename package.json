{
  "name": "inkai-sby",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:pull": "prisma db pull",
    "db:seed:pengprov-jatim": "tsx scripts/seed-pengprov-jatim.ts",
    "db:local:up": "docker compose up -d",
    "db:local:down": "docker compose down",
    "db:local:reset": "docker compose down -v && docker compose up -d",
    "db:local:assert": "tsx scripts/assert-local-database.ts",
    "db:local:bootstrap": "tsx scripts/bootstrap-local.ts",
    "db:local:seed": "tsx scripts/seed-local.ts",
    "db:local:dump-from-prod": "tsx scripts/dump-prod-to-local.ts",
    "db:check-drift": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "db:backfill:latber-flat-fee": "tsx scripts/backfill-latber-flat-fee.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.23",
    "@ai-sdk/react": "^4.0.55",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.110.8",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.6.1",
    "ai": "^7.0.52",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "prisma": "^5.22.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/html2canvas": "^0.5.35",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
